+// A cast to or from one of the __ptr32/__ptr64 spaces (270-272).
+//
+// AArch64 keeps every pointer in a 64-bit DAG value whatever its address
+// space -- see getPointerTy, which returns i64 unconditionally so that the
+// addressing modes stay usable -- and narrows one only where it is stored.
+// So this cast moves no bits in the common direction: a store through a
+// 32-bit space writes four bytes by itself, and a load from one brings in
+// four with the top half undefined.
+//
+// What is left is the direction that makes a full address out of a 32-bit
+// pointer, where the low half has to be extended: unsigned for __uptr,
+// signed for __sptr. Doing it here rather than at the load is what makes the
+// undefined top half safe.
+static SDValue LowerADDRSPACECAST(SDValue Op, SelectionDAG &DAG) {
+  SDLoc dl(Op);
+  SDValue Src = Op.getOperand(0);
+  MVT DstVT = Op.getSimpleValueType();
+
+  AddrSpaceCastSDNode *N = cast<AddrSpaceCastSDNode>(Op.getNode());
+  unsigned SrcAS = N->getSrcAddressSpace();
+
+  assert(SrcAS != N->getDestAddressSpace() &&
+         "addrspacecast must be between different address spaces");
+
+  if (SrcAS == AArch64AS::PTR32_UPTR)
+    return DAG.getZeroExtendInReg(Src, dl, MVT::i32);
+  if (SrcAS == AArch64AS::PTR32_SPTR)
+    return DAG.getNode(ISD::SIGN_EXTEND_INREG, dl, DstVT, Src,
+                       DAG.getValueType(MVT::i32));
+  return Src;
+}
