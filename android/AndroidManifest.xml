<?xml version="1.0" encoding="utf-8"?>
<!-- Yu-Gi-Oh! Forbidden Memories Recompiled, as an Android app
     (notes/android-build.md). Built by tools/pc/build_apk.py, which fills in
     the version from the release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yfm.redecomp"
    android:versionCode="1"
    android:versionName="0.1"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- A physical pad is an alternative to the on-screen one, never a
         requirement; the same goes for Bluetooth and USB that carry it. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- No permission is asked for. The disc image, the saves and the
         screenshots live in the app's own folder on shared storage, which
         needs none, and the update check is off on Android
         (src/pc/platform/update_net.c), so there is no use for the network. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="com.yfm.redecomp.MemoriesActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:exported="true"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A pad plugged in by USB reaches the running game. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>
</manifest>
